{
  "name": "dos-d-ane-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Suivi de posture par webcam pour ordinateur",
  "main": "main.cjs",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "model:yolo": "node scripts/get-yolo-model.mjs",
    "dev": "npm run model:yolo && npm run prepare:assets && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:web": "npm run model:yolo && npm run prepare:assets && vite --host 127.0.0.1",
    "build": "npm run model:yolo && npm run prepare:assets && vite build",
    "smoke": "npm run build && electron . --smoke",
    "smoke:models": "npm run build && electron . --smoke --smoke-models",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "check": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "@rive-app/canvas": "^2.44.2",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@vitejs/plugin-react": "*",
    "concurrently": "*",
    "electron": "^44.7.0",
    "electron-builder": "*",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.3.4",
    "wait-on": "*"
  },
  "build": {
    "appId": "fr.dosdane.desktop",
    "productName": "Dos d'âne",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "assets/icon.ico",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
