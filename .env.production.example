# Environnement de production (branche main).
# En CD, ce fichier est généré à partir des variables et secrets de
# l'environnement GitHub « production ». Ne jamais committer le vrai fichier.
APP_ENV=production
WEB_PORT=80
CORS_ORIGINS=http://dos-d-ane.example

# Secrets : générer avec `openssl rand -hex 32`.
SENSOR_API_KEY=
POSTGRES_USER=dosdane
POSTGRES_PASSWORD=
POSTGRES_DB=dosdane

IMAGE_REGISTRY=ghcr.io/juc0ag0g0
IMAGE_TAG=production
