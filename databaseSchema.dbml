// DOS-D'ÂNE : schéma de la base (envoi-evenements, 2026-10-19)
// Généré depuis server/prisma/schema.prisma et ses migrations.
// PostgreSQL 18, id en UUID v7 (uuidv7()), dates en timestamptz(3).

Enum Role {
  user
  admin
}

Enum BodyPart {
  nose
  left_eye
  right_eye
  left_ear
  right_ear
  left_shoulder
  right_shoulder
  left_elbow
  right_elbow
  left_wrist
  right_wrist
  left_hip
  right_hip
  left_knee
  right_knee
  left_ankle
  right_ankle
}

Table users {
  id uuidv7 [pk, default: `uuidv7()`]
  email string [not null, unique, note: 'Stocké en minuscules']
  displayName string [not null, note: 'Unique sans tenir compte de la casse']
  passwordHash string [not null]
  role Role [not null, default: 'user']
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  indexes {
    `lower("displayName")` [unique, name: 'users_displayName_lower_key']
  }
}

Table devices {
  id uuidv7 [pk, default: `uuidv7()`]
  userId uuidv7 [not null]
  name string [not null]
  type string [not null, note: 'web, mobile, desktop, raspberry ; seul web ne capture pas']
  model string
  captureEligible boolean [not null, default: false, note: 'Toujours false pour web']
  captureStatus string [note: 'active / inactive si éligible, null sinon']
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  indexes {
    userId
  }
}

Table authSessions {
  id uuidv7 [pk, default: `uuidv7()`, note: 'sid porté par le JWT']
  userId uuidv7 [not null]
  deviceId uuidv7 [not null]
  expiresAt timestamptz [not null, note: 'Expiration glissante']
  revokedAt timestamptz
  lastUsedAt timestamptz [not null, default: `now()`]
  ipAddress string
  userAgent string
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    userId
    deviceId
  }
}

Table analysisSessions {
  id uuidv7 [pk, default: `uuidv7()`]
  userId uuidv7 [not null]
  startedAt timestamptz [note: 'null : en préparation ; endedAt null : en cours ; sinon terminée']
  endedAt timestamptz
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  indexes {
    userId
  }
}

Table deviceSessions {
  id uuidv7 [pk, default: `uuidv7()`]
  analysisSessionId uuidv7 [not null]
  deviceId uuidv7 [not null]
  startedAt timestamptz [not null, note: 'Ajout à la session']
  endedAt timestamptz
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (analysisSessionId, deviceId) [unique]
    deviceId [unique, name: 'deviceSessions_deviceId_open_key', note: 'Partiel : WHERE endedAt IS NULL (une seule session ouverte par appareil)']
    deviceId
  }
}

Table captures {
  id uuidv7 [pk, default: `uuidv7()`]
  deviceSessionId uuidv7 [not null]
  capturedAt timestamptz [not null]
  imageWidth int [not null, note: 'pixels, > 0']
  imageHeight int [not null, note: 'pixels, > 0']
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (deviceSessionId, capturedAt)
  }
}

Table keypoints {
  id uuidv7 [pk, default: `uuidv7()`]
  captureId uuidv7 [not null]
  bodyPart BodyPart [not null]
  x int [not null, note: 'pixels, >= 0']
  y int [not null, note: 'pixels, >= 0']
  confidence float [note: 'Entre 0 et 1']
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (captureId, bodyPart) [unique]
  }
}

Table postureEvents {
  id uuidv7 [pk, default: `uuidv7()`]
  deviceSessionId uuidv7 [not null]
  clientId text [not null, note: 'Id donné par le Pi (evt_0001) : envoi idempotent']
  type text [not null, note: 'FORWARD_HEAD, TRUNK_FORWARD, TRUNK_BACKWARD, IMMOBILE']
  startedAt timestamptz [not null, note: 'Heure du Pi']
  endedAt timestamptz [note: 'null tant que l alerte dure ; >= startedAt']
  headAngleAvg float [note: 'Degrés, -180 à 180, au déclenchement ; null pour IMMOBILE']
  trunkAngleAvg float [note: 'Degrés, -180 à 180, au déclenchement ; null pour IMMOBILE']
  causes jsonb [note: 'Part de chaque cause en %, ex. {"FORWARD_HEAD": 60, "NECK_FLEXION": 40}']
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  indexes {
    (deviceSessionId, clientId) [unique]
    (deviceSessionId, startedAt)
  }
}

Table postureSummaries {
  id uuidv7 [pk, default: `uuidv7()`]
  deviceSessionId uuidv7 [not null]
  clientId text [not null, note: 'Id donné par le Pi (res_0001) : envoi idempotent']
  periodStart timestamptz [not null]
  periodEnd timestamptz [not null, note: '>= periodStart']
  score int [note: '% du temps en bonne posture, 0 à 100 ; null si rien n a été suivi']
  secondsGreen int [not null, note: '>= 0']
  secondsOrange int [not null, note: '>= 0']
  secondsRed int [not null, note: '>= 0']
  secondsIgnored int [not null, note: '>= 0, image mal vue']
  secondsAbsent int [not null, note: '>= 0, personne devant la caméra']
  createdAt timestamptz [not null, default: `now()`]

  indexes {
    (deviceSessionId, clientId) [unique]
    (deviceSessionId, periodStart)
  }
}

Table exercises {
  id uuidv7 [pk, default: `uuidv7()`]
  title string [not null]
  zone string [not null, note: 'nuque, epaules, dos, poignets, yeux, jambes']
  isPreventive boolean [not null, default: false]
  isForPain boolean [not null, default: false, note: 'Au moins un des deux types (CHECK)']
  durationSeconds int [not null, note: '> 0']
  posture string [not null, note: 'assis, debout, assis ou debout']
  precautions string [not null, default: '']
  mediaId uuidv7
  status string [not null, default: 'draft', note: 'draft / published ; publié : au moins une étape']
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]

  indexes {
    (status, zone)
  }
}

Table exerciseSteps {
  id uuidv7 [pk, default: `uuidv7()`]
  exerciseId uuidv7 [not null]
  position int [not null]
  text string [not null]

  indexes {
    (exerciseId, position) [unique]
  }
}

Table postureTips {
  id uuidv7 [pk, default: `uuidv7()`]
  key string [not null, unique, note: 'ecran, dossier, pieds, clavier, lumiere, pauses : 6 lignes fixes']
  position int [not null, note: 'Ordre choisi par glisser-déposer ; le numéro du repère est calculé']
  title string [not null]
  shortText string [not null]
  tutorialText string [not null]
  sourceLabel string [note: 'Avec sourceUrl (https://) ou aucun des deux']
  sourceUrl string
  isVisible boolean [not null, default: true]
  mediaId uuidv7
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]
}

Table painZones {
  id uuidv7 [pk, default: `uuidv7()`]
  name string [not null]
  position int [not null]
  intro string [not null, default: '']
  sourceLabel string [note: 'Avec sourceUrl (https://) ou aucun des deux']
  sourceUrl string
  status string [not null, default: 'draft', note: 'draft / published']
  createdAt timestamptz [not null, default: `now()`]
  updatedAt timestamptz [not null, default: `now()`]
}

Table painZoneAdvices {
  id uuidv7 [pk, default: `uuidv7()`]
  painZoneId uuidv7 [not null]
  kind string [not null, note: 'helps (ce qui aide) / avoid (à éviter)']
  position int [not null]
  text string [not null]

  indexes {
    (painZoneId, kind, position) [unique]
  }
}

Table painZoneExercises {
  painZoneId uuidv7 [not null]
  exerciseId uuidv7 [not null]
  position int [not null, note: 'De 1 à 3 : 3 exercices conseillés au plus']

  indexes {
    (painZoneId, exerciseId) [pk]
    (painZoneId, position) [unique]
    exerciseId
  }
}

Table media {
  id uuidv7 [pk, default: `uuidv7()`]
  storageKey string [not null, unique, note: 'Clé de l’objet dans le S3 local']
  mimeType string [not null, note: 'image/gif, image/png, video/mp4']
  sizeBytes int [not null, note: '5 Mo max']
  width int
  height int
  uploadedById uuidv7
  createdAt timestamptz [not null, default: `now()`]
}

Table adviceSettings {
  key string [pk, note: 'whenToSeeDoctor']
  text string [not null]
  updatedAt timestamptz [not null, default: `now()`]
}

Ref: devices.userId > users.id [delete: cascade]
Ref: authSessions.userId > users.id [delete: cascade]
Ref: authSessions.deviceId > devices.id [delete: cascade]
Ref: analysisSessions.userId > users.id [delete: cascade]
Ref: deviceSessions.analysisSessionId > analysisSessions.id [delete: cascade]
Ref: deviceSessions.deviceId > devices.id [delete: cascade]
Ref: captures.deviceSessionId > deviceSessions.id [delete: cascade]
Ref: keypoints.captureId > captures.id [delete: cascade]
Ref: postureEvents.deviceSessionId > deviceSessions.id [delete: cascade]
Ref: postureSummaries.deviceSessionId > deviceSessions.id [delete: cascade]
Ref: exercises.mediaId > media.id [delete: set null]
Ref: exerciseSteps.exerciseId > exercises.id [delete: cascade]
Ref: postureTips.mediaId > media.id [delete: set null]
Ref: painZoneAdvices.painZoneId > painZones.id [delete: cascade]
Ref: painZoneExercises.painZoneId > painZones.id [delete: cascade]
Ref: painZoneExercises.exerciseId > exercises.id [delete: cascade]
Ref: media.uploadedById > users.id [delete: set null]
