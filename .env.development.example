# Environnement de développement local.
#   cp .env.development.example .env.development && task dev
APP_ENV=development
WEB_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081

# Swagger (/api/docs) : actif hors production, sauf SWAGGER_ENABLED=true.
SWAGGER_ENABLED=true

# Valeurs de dev uniquement, sans importance.
POSTGRES_USER=dosdane
POSTGRES_PASSWORD=dosdane-dev
POSTGRES_DB=dosdane

# Images utilisées par `task up` (le mode dev les ignore).
IMAGE_REGISTRY=ghcr.io/juc0ag0g0
IMAGE_TAG=staging
