# Environnement de développement local.
#   cp .env.development.example .env.development && make dev
APP_ENV=development
WEB_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081

# Valeurs de dev uniquement, sans importance.
SENSOR_API_KEY=change-me-dev-key-0123456789
POSTGRES_USER=dosdane
POSTGRES_PASSWORD=dosdane-dev
POSTGRES_DB=dosdane

# Images utilisées par `make up` (le mode dev les ignore).
IMAGE_REGISTRY=ghcr.io/juc0ag0g0
IMAGE_TAG=staging
