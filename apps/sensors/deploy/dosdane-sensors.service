[Unit]
Description=Dos d'âne - acquisition des capteurs
Documentation=https://github.com/JUC0AG0G0/dos-d-ane/tree/main/docs
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dosdane
Group=dosdane
# Groupes d'accès au matériel (I2C, GPIO, port série) sur Raspberry Pi OS.
SupplementaryGroups=i2c gpio dialout
EnvironmentFile=/etc/dosdane/sensors.env
ExecStart=/opt/dosdane-sensors/venv/bin/dosdane-sensors run
Restart=on-failure
RestartSec=10
# Durcissement : le service n'a besoin que du réseau et des bus matériels.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
