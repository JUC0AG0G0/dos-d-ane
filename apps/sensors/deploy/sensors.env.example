# Copié par install.sh vers /etc/dosdane/sensors.env (droits 600).
# Changer d'environnement = changer DOSDANE_ENV et DOSDANE_API_URL puis
# `sudo systemctl restart dosdane-sensors`.

# development | staging | production
DOSDANE_ENV=development
DOSDANE_API_URL=http://192.168.1.10:3000/api
# Même valeur que SENSOR_API_KEY côté backend (au moins 16 caractères).
DOSDANE_SENSOR_API_KEY=change-me-dev-key-0123456789
# Identifiant de l'appareil (par défaut : nom d'hôte du Raspberry Pi).
DOSDANE_DEVICE_ID=
# Capteurs à lire, séparés par des virgules (voir `dosdane-sensors list`).
DOSDANE_SENSORS=fake
DOSDANE_INTERVAL_SECONDS=5
