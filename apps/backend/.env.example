# Copier en .env pour lancer le backend hors Docker (npm run start:dev).
APP_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Au moins 16 caractères. Générer avec : openssl rand -hex 32
SENSOR_API_KEY=change-me-dev-key-0123456789
DATABASE_URL=postgresql://dosdane:dosdane@localhost:5432/dosdane
