# Environnement de recette (branche develop), sur un PC de la formation.
# En CD, ce fichier est généré à partir des variables et secrets de
# l'environnement GitHub « staging ». Ne jamais committer le vrai fichier.
APP_ENV=staging
WEB_PORT=8080
CORS_ORIGINS=http://staging.dos-d-ane.example

# Secrets : générer avec `openssl rand -hex 32`.
SENSOR_API_KEY=
POSTGRES_USER=dosdane
POSTGRES_PASSWORD=
POSTGRES_DB=dosdane

IMAGE_REGISTRY=ghcr.io/juc0ag0g0
IMAGE_TAG=staging
