# Variables de production : chacune doit exister dans les secrets GitHub du
# dépôt (Settings > Secrets and variables > Actions), sous le même nom.
# Ce fichier ne contient que des noms, jamais de valeur : il n'est pas copié
# sur le serveur. La CI bloque le merge sur main s'il manque un secret.
# Guide complet : deployReadME.md.

# --- Application (écrites dans .env.prod sur le serveur) ---
# Lettres, chiffres et . _ ~ - seulement (ils forment l'URL de la base).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# 32 caractères minimum : openssl rand -base64 48
JWT_SECRET=
# Compte admin créé au démarrage. Mot de passe : 8 caractères minimum.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Connexion SSH au serveur (utilisées par GitHub Actions seulement) ---
DEPLOY_HOST=
DEPLOY_PORT=
DEPLOY_USER=
# Clé privée ed25519 dédiée au déploiement, en entier.
DEPLOY_SSH_KEY=
# Sortie de : ssh-keyscan -p <port> <hôte>
DEPLOY_KNOWN_HOSTS=
