{
  "name": "dos-d-ane",
  "private": true,
  "description": "Outillage commun du monorepo (hooks Git). Chaque app a son propre package.json dans apps/.",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11",
      "onFail": "error"
    }
  }
}
