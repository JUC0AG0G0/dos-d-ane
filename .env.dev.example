# Environnement de développement, copié automatiquement en .env.dev (task setup).
# Lu par Docker (task dev) et par le serveur lancé sans Docker (task start).
APP_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

# Base de données (valeurs de dev, sans importance).
POSTGRES_USER=dosdane
POSTGRES_PASSWORD=dosdane-dev
POSTGRES_DB=dosdane
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Construite à partir des variables ci-dessus : ne changer qu'elles.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
