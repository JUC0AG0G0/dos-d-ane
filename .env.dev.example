# Environnement de développement, copié automatiquement en .env.dev (task setup).
# Lu par docker compose (task dev).
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

# Ports sur le poste. S'ils sont pris, `task dev` propose des ports libres.
PORT=3000
POSTGRES_PORT=5432
PGADMIN_PORT=5050

# Base de données (valeurs de dev, sans importance).
POSTGRES_USER=dosdane
POSTGRES_PASSWORD=dosdane-dev
POSTGRES_DB=dosdane
# Construite à partir des variables ci-dessus : ne changer qu'elles.
# « db » est le nom de la base dans le réseau Docker.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Clé secrète qui signe les JWT (au moins 32 caractères). À générer une fois
# par poste, jamais commitée ni partagée :
#   openssl rand -base64 48
# Sans openssl : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# La changer déconnecte tout le monde (les tokens existants deviennent invalides).
JWT_SECRET=

# pgAdmin (dev uniquement). Le compte est demandé par pgAdmin au démarrage ;
# en mode bureau (PGADMIN_SERVER_MODE=False), il n'y a pas d'écran de connexion.
PGADMIN_DEFAULT_EMAIL=dev@example.com
PGADMIN_DEFAULT_PASSWORD=dev
PGADMIN_SERVER_MODE=False
