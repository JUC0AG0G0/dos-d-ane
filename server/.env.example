# Copier en .env pour lancer le serveur hors Docker (npm run start:dev).
APP_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
DATABASE_URL=postgresql://dosdane:dosdane@localhost:5432/dosdane
# Swagger est actif hors production ; mettre true pour l'activer en production.
SWAGGER_ENABLED=false
