// Schéma de la base (https://www.prisma.io/docs/orm/prisma-schema).
// Après une modification, avec `task dev` lancé : `task db:migrate` crée la
// migration et l'applique.
//
// Conventions :
// - id en UUID v7, générés par PostgreSQL 18 (`uuidv7()`, natif, sans extension) ;
// - colonnes en camelCase, tables en camelCase au pluriel (@@map) ;
// - dates en timestamptz (millisecondes, comme les Date JavaScript).
// Les contraintes CHECK, que Prisma ne sait pas décrire, sont ajoutées à la
// main dans la migration.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Rôle d'un compte. Tout compte créé est user, sauf l'admin : en production,
/// celui de ADMIN_EMAIL (créé au démarrage) ; hors production, le premier inscrit.
enum Role {
  user
  admin
}

/// email (stocké en minuscules) et displayName sont uniques. displayName l'est
/// sans tenir compte de la casse : index sur lower("displayName") ajouté à la
/// main dans la migration.
model User {
  id               String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email            String            @unique
  displayName      String
  passwordHash     String
  role             Role              @default(user)
  devices          Device[]
  authSessions     AuthSession[]
  analysisSessions AnalysisSession[]
  uploadedMedia    Media[]
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("users")
}

/// Appareil lié à un compte : navigateur (web), téléphone (mobile), caméra...
/// Un navigateur n'est jamais éligible à la capture (captureEligible false).
/// L'appareil capture tant qu'il est dans une session lancée (en cours ou en
/// pause) : c'est déduit de deviceSessions, rien n'est stocké ici.
/// keyHash : empreinte SHA-256 de la clé d'un Raspberry Pi (jamais la clé
/// elle-même), qu'il échange contre un JWT (POST /auth/device-login) au lieu
/// d'un mot de passe ; null sans clé ou après révocation.
/// pairingCodeHash : empreinte du code d'étiquette d'un Pi ajouté par son
/// code ; le même code tapé de nouveau dans ce compte reprend cet appareil
/// (même deviceId, nom et historique) au lieu d'en créer un autre.
model Device {
  id              String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String          @db.Uuid
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  type            String
  model           String?
  captureEligible Boolean         @default(false)
  keyHash         String?
  keyCreatedAt    DateTime?       @db.Timestamptz(3)
  pairingCodeHash String?
  authSessions    AuthSession[]
  deviceSessions  DeviceSession[]
  pairing         DevicePairing?
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([userId, pairingCodeHash])
  @@index([userId])
  @@map("devices")
}

/// Appairage d'un Raspberry Pi par le code de son étiquette
/// (edge/docs/liaison-serveur.md §2). Créé à la 1re demande du Pi sans clé,
/// qui lie son secret de relève au code ; deviceId rempli quand un compte
/// valide le code ; supprimé quand le Pi relève sa clé. Seules les empreintes
/// SHA-256 du code et du secret sont gardées.
model DevicePairing {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  codeHash   String    @unique
  secretHash String
  deviceId   String?   @unique @db.Uuid
  device     Device?   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  claimedAt  DateTime? @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@map("devicePairings")
}

/// Connexion d'un utilisateur sur un appareil. Le JWT renvoyé au client porte
/// l'id de cette session (sid) : il n'est accepté que si elle est active.
/// expiresAt est repoussée à chaque requête (expiration glissante).
/// ipAddress et userAgent sont relevés à la connexion.
/// Une session est active tant qu'elle n'est ni révoquée ni expirée ; elle
/// reste en base ensuite pour l'historique des connexions.
/// kind : user (login par mot de passe, tous les droits du compte) ou device
/// (login d'un Raspberry Pi par sa clé : seulement les routes marquées
/// @DeviceAllowed, vérifié par un CHECK et par le guard global).
model AuthSession {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String    @db.Uuid
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @db.Timestamptz(3)
  ipAddress  String?
  userAgent  String?
  kind       String    @default("user")
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([deviceId])
  @@map("authSessions")
}

/// Session d'analyse générale d'un utilisateur, sur un ou plusieurs appareils.
/// État déduit des dates : en préparation (startedAt null), en cours (endedAt
/// null), en pause (une pause ouverte) puis terminée.
model AnalysisSession {
  id             String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String                 @db.Uuid
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt      DateTime?              @db.Timestamptz(3)
  endedAt        DateTime?              @db.Timestamptz(3)
  deviceSessions DeviceSession[]
  pauses         AnalysisSessionPause[]
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("analysisSessions")
}

/// Pause d'une session en cours : toute la session arrête de capturer et le
/// serveur refuse les captures. endedAt null tant que la pause dure ; une seule
/// pause ouverte par session : index unique partiel sur analysisSessionId
/// (endedAt null) ajouté à la main dans la migration. Le temps de pause est
/// retiré de la durée active.
model AnalysisSessionPause {
  id                String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  analysisSessionId String          @db.Uuid
  analysisSession   AnalysisSession @relation(fields: [analysisSessionId], references: [id], onDelete: Cascade)
  startedAt         DateTime        @db.Timestamptz(3)
  endedAt           DateTime?       @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)

  @@index([analysisSessionId])
  @@map("analysisSessionPauses")
}

/// Participation d'un appareil éligible à une session d'analyse.
/// endedAt null : l'appareil est dans une session en préparation ou lancée.
/// Il peut être dans plusieurs sessions en préparation, mais dans une seule
/// session lancée : vérifié par AnalysisService au lancement et à l'ajout.
/// Supprimer un appareil supprime ses sessions et leurs captures. Un Restrict
/// bloquerait la suppression d'un utilisateur (droit à l'effacement), car
/// PostgreSQL supprime ses appareils avant ses sessions d'analyse.
model DeviceSession {
  id                String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  analysisSessionId String           @db.Uuid
  analysisSession   AnalysisSession  @relation(fields: [analysisSessionId], references: [id], onDelete: Cascade)
  deviceId          String           @db.Uuid
  device            Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  startedAt         DateTime         @db.Timestamptz(3)
  endedAt           DateTime?        @db.Timestamptz(3)
  captures          Capture[]
  postureEvents     PostureEvent[]
  postureSummaries  PostureSummary[]
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([analysisSessionId, deviceId])
  @@index([deviceId])
  @@map("deviceSessions")
}

/// Prise de vue d'un appareil à un instant donné. L'image n'est pas stockée,
/// seulement sa taille en pixels pour replacer les keypoints.
model Capture {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deviceSessionId String        @db.Uuid
  deviceSession   DeviceSession @relation(fields: [deviceSessionId], references: [id], onDelete: Cascade)
  capturedAt      DateTime      @db.Timestamptz(3)
  imageWidth      Int
  imageHeight     Int
  keypoints       Keypoint[]
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  @@index([deviceSessionId, capturedAt])
  @@map("captures")
}

/// Articulation détectée par le modèle de pose. Reprend les 17 points du
/// format COCO (MoveNet, YOLO-Pose, OpenPose), avec les mêmes noms : nose sert
/// de point pour la tête.
enum BodyPart {
  nose
  left_eye
  right_eye
  left_ear
  right_ear
  left_shoulder
  right_shoulder
  left_elbow
  right_elbow
  left_wrist
  right_wrist
  left_hip
  right_hip
  left_knee
  right_knee
  left_ankle
  right_ankle
}

/// Point d'une articulation sur une capture, en pixels (origine en haut à
/// gauche). Une articulation non détectée n'a simplement pas de ligne.
model Keypoint {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  captureId  String   @db.Uuid
  capture    Capture  @relation(fields: [captureId], references: [id], onDelete: Cascade)
  bodyPart   BodyPart
  x          Int
  y          Int
  confidence Float?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([captureId, bodyPart])
  @@map("keypoints")
}

// --- Résultats envoyés par le Pi (edge/docs/liaison-serveur.md) --------------
// Calculés sur le Pi : aucune image ni aucun point du corps (audit §7.2).
// clientId est l'id donné par le Pi (evt_0001, res_0001) : unique par
// participation, il rend l'envoi idempotent (un message renvoyé après une
// coupure ne crée pas de doublon). Les heures sont celles du Pi (NTP).

/// Alerte de posture : créée à son début, complétée à sa fin (endedAt null tant
/// qu'elle dure, ou si le Pi s'est arrêté avant). type : FORWARD_HEAD (tête en
/// avant ou baissée), TRUNK_FORWARD, TRUNK_BACKWARD, IMMOBILE (assis trop
/// longtemps), vérifié par un CHECK. Angles moyens au déclenchement (null pour
/// IMMOBILE). causes : part de chaque cause en %, ex. {"FORWARD_HEAD": 60,
/// "NECK_FLEXION": 40}.
model PostureEvent {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deviceSessionId String        @db.Uuid
  deviceSession   DeviceSession @relation(fields: [deviceSessionId], references: [id], onDelete: Cascade)
  clientId        String
  type            String
  startedAt       DateTime      @db.Timestamptz(3)
  endedAt         DateTime?     @db.Timestamptz(3)
  headAngleAvg    Float?
  trunkAngleAvg   Float?
  causes          Json?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([deviceSessionId, clientId])
  @@index([deviceSessionId, startedAt])
  @@map("postureEvents")
}

/// Résumé d'une période (5 min) : score = % du temps en bonne posture (null si
/// rien n'a été suivi), temps passé en vert / orange / rouge, image ignorée,
/// personne absente.
model PostureSummary {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deviceSessionId String        @db.Uuid
  deviceSession   DeviceSession @relation(fields: [deviceSessionId], references: [id], onDelete: Cascade)
  clientId        String
  periodStart     DateTime      @db.Timestamptz(3)
  periodEnd       DateTime      @db.Timestamptz(3)
  score           Int?
  secondsGreen    Int
  secondsOrange   Int
  secondsRed      Int
  secondsIgnored  Int
  secondsAbsent   Int
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([deviceSessionId, clientId])
  @@index([deviceSessionId, periodStart])
  @@map("postureSummaries")
}

// --- Conseils : exercices, réglages du poste, repères douleur ---------------
// Contenu géré par les admins (Administration › Conseils et exercices) et lu
// par tous les utilisateurs connectés (Conseils). Les ordres sont des entiers
// position réécrits en transaction à chaque glisser-déposer. Les valeurs fixes
// (zone, status, kind) sont des textes vérifiés par les DTO et par des CHECK
// ajoutés à la main dans la migration.

/// Exercice proposé dans Conseils › Exercices.
/// zone : nuque, epaules, dos, poignets, yeux, jambes ; status : draft ou
/// published. Un exercice a au moins un type (CHECK isPreventive OR isForPain).
/// Publié, il a aussi au moins une étape (vérifié par le service).
model Exercise {
  id              String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  title           String
  zone            String
  isPreventive    Boolean            @default(false)
  isForPain       Boolean            @default(false)
  durationSeconds Int
  posture         String
  precautions     String             @default("")
  mediaId         String?            @db.Uuid
  media           Media?             @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  status          String             @default("draft")
  steps           ExerciseStep[]
  painZones       PainZoneExercise[]
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([status, zone])
  @@map("exercises")
}

/// Étape « Comment faire » d'un exercice, remplacées en bloc à chaque
/// enregistrement.
model ExerciseStep {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  exerciseId String   @db.Uuid
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  position   Int
  text       String

  @@unique([exerciseId, position])
  @@map("exerciseSteps")
}

/// Réglage du poste (page Bien s'installer). Exactement 6 lignes, créées par
/// migration et jamais supprimées : key (ecran, dossier, pieds, clavier,
/// lumiere, pauses) fixe l'icône et la place du repère sur le schéma, côté
/// front. Le numéro du repère est calculé (rang parmi les réglages visibles).
/// Source : libellé et lien https:// renseignés ensemble ou pas du tout.
model PostureTip {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key          String   @unique
  position     Int
  title        String
  shortText    String
  tutorialText String
  sourceLabel  String?
  sourceUrl    String?
  isVisible    Boolean  @default(true)
  mediaId      String?  @db.Uuid
  media        Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("postureTips")
}

/// Zone de douleur (page En cas de douleur). status : draft ou published.
/// Source : libellé et lien https:// renseignés ensemble ou pas du tout.
model PainZone {
  id          String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  position    Int
  intro       String             @default("")
  sourceLabel String?
  sourceUrl   String?
  status      String             @default("draft")
  advices     PainZoneAdvice[]
  exercises   PainZoneExercise[]
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("painZones")
}

/// Point « Ce qui aide » (kind helps) ou « À éviter » (kind avoid) d'une zone.
model PainZoneAdvice {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  painZoneId String   @db.Uuid
  painZone   PainZone @relation(fields: [painZoneId], references: [id], onDelete: Cascade)
  kind       String
  position   Int
  text       String

  @@unique([painZoneId, kind, position])
  @@map("painZoneAdvices")
}

/// Exercice conseillé pour une zone : 3 au plus, position de 1 à 3 (CHECK).
/// Seuls les exercices publiés y figurent : le service retire le lien quand
/// un exercice repasse en brouillon.
model PainZoneExercise {
  painZoneId String   @db.Uuid
  painZone   PainZone @relation(fields: [painZoneId], references: [id], onDelete: Cascade)
  exerciseId String   @db.Uuid
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  position   Int

  @@id([painZoneId, exerciseId])
  @@unique([painZoneId, position])
  @@index([exerciseId])
  @@map("painZoneExercises")
}

/// Fichier envoyé par un admin (GIF, PNG ou MP4, 5 Mo max). Le contenu est
/// dans le stockage S3 local, sous la clé storageKey ; seul le serveur y
/// accède. width et height sont null pour une vidéo.
model Media {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  storageKey   String       @unique
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  uploadedById String?      @db.Uuid
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  exercises    Exercise[]
  postureTips  PostureTip[]
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  @@map("media")
}

/// Textes uniques des Conseils, par clé. whenToSeeDoctor : message « Quand
/// consulter un médecin » en haut de En cas de douleur.
model AdviceSetting {
  key       String   @id
  text      String
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("adviceSettings")
}
