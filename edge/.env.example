# Configuration de la liaison avec le serveur (docs/liaison-serveur.md).
# Copier en .env (ignoré par Git), le remplir, puis le protéger : chmod 600 .env
# Charger avant de lancer : set -a; source .env; set +a

# Adresse du serveur, sans / final (https:// en prod : liaison chiffrée)
DOSDANE_SERVEUR=http://localhost:3000

# Appairage par code (docs/liaison-serveur.md §2) : écrits par outils/preparer.py. Sans clé, le Pi attend
# qu'un compte tape ce code (étiquette) dans « Ajouter un Raspberry Pi », puis écrit lui-même sa clé ci-dessous.
DOSDANE_CODE=
DOSDANE_SECRET_APPAIRAGE=

# Identité du Pi : deviceId et clé donnés une seule fois par le serveur (appairage par code, ou POST /api/devices
# et POST /api/devices/:id/key en dev). Vides : le Pi attend d'être appairé. Aucun mot de passe sur le Pi.
DOSDANE_APPAREIL=
DOSDANE_CLE=
